#!/usr/bin/env python3
"""Upload and execute a PRG file on the C64."""

import sys
from pathlib import Path
from c64lib import C64, base_parser, load_config


def main():
    p = base_parser('Upload and execute a PRG file on the C64')
    p.add_argument('file', help='PRG file to run')
    args = p.parse_args()

    local = Path(args.file)
    if not local.exists():
        print(f'Error: file not found: {args.file}', file=sys.stderr)
        sys.exit(1)

    if local.suffix.lower() != '.prg':
        print(f'Warning: {local.name} does not have a .prg extension')

    data = local.read_bytes()

    ip = load_config(args.ip)
    c64 = C64(ip)

    if not c64.alive():
        print(f'Cannot reach C64 at {ip}', file=sys.stderr)
        sys.exit(1)

    print(f'Running {local.name} ({len(data)} bytes) ... ', end='', flush=True)
    try:
        result = c64.run_prg(data)
        if result.get('errors'):
            print(f'FAILED: {result["errors"]}')
            sys.exit(1)
        print('done.')
    except Exception as e:
        print(f'FAILED: {e}', file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
