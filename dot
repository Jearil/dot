#!/usr/bin/env bash
# Everyday commands for this repo. See README.

set -e

DOT_DIR=$(cd "$(dirname "$(readlink "$0" || echo "$0")")" && pwd)
cd "$DOT_DIR"

case "${1:-}" in
    status)
        git fetch -q origin || echo "Couldn't reach origin; ahead/behind may be stale."
        git status -sb
        ;;
    sync)
        git pull --ff-only
        ./install
        ;;
    packages)
        if [ "$(uname)" = "Darwin" ]; then
            ./brew.sh
        else
            grep -v '^#' packages/dnf.txt | xargs sudo dnf install -y
            if [ "${2:-}" = "--flatpak" ]; then
                grep -v '^#' packages/flatpak.txt | xargs flatpak install -y flathub
            fi
        fi
        ;;
    kde)
        ./kde/apply.sh
        ;;
    macos)
        ./osx.sh
        ;;
    *)
        echo "Usage: dot status | sync | packages [--flatpak] | kde | macos" >&2
        exit 1
        ;;
esac
