[Unit]
Description=Steam Center Sound - display-aware audio routing daemon
Documentation=https://github.com/local/steam-center-sound
After=graphical-session.target
PartOf=graphical-session.target
Wants=pipewire.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/steam-center-sound/steam_center_soundd.py
Restart=on-failure
RestartSec=2
# KWin script calls us on the session bus; make sure we can reach Wayland tools.
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_CURRENT_DESKTOP=KDE

[Install]
WantedBy=graphical-session.target
